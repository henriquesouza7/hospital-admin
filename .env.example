# URL do projeto Supabase criado pelo responsável do projeto.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública recomendada pelo Supabase (publishable key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade com projetos que ainda fornecem a chave pública anon.
# Use apenas uma das duas chaves públicas acima.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
