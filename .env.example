# Neon Auth server endpoint. Keep this server-side value private.
NEON_AUTH_BASE_URL=<Neon Auth URL>

# At least 32 random characters. Never expose this value to the browser.
NEON_AUTH_COOKIE_SECRET=<server-only cookie secret>

# Server-side Neon Data API endpoint.
NEON_DATA_API_URL=<Neon Data API URL>

# Optional in development (defaults to http://localhost:3000); required for password reset in production.
# APP_BASE_URL=https://example.com
